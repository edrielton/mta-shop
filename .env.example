# Variáveis de Ambiente - TEMPLATE

# ⚠️ NUNCA commita este arquivo com valores secretos!
# Este é apenas um TEMPLATE para ajudar desenvolvedores
# Copie para .env e preencha com seus valores reais

# ====================
# API Configuration
# ====================
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=5000

# ====================
# Payment Gateways
# ====================
# Stripe - Obtenha em: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_seu_chave_publica_aqui

# Mercado Pago - Obtenha em: https://www.mercadopago.com/developers
VITE_MERCADOPAGO_PUBLIC_KEY=seu_chave_publica_aqui

# ====================
# MTA Integration
# ====================
# Token de segurança para comunicação com servidor MTA
# Deve ser o mesmo em ambos os lados (site + mta_resource)
VITE_MTA_API_TOKEN=seu_token_secreto_aqui

# URL do servidor MTA
VITE_MTA_SERVER_URL=http://seu-ip-servidor:22005

# ====================
# Firebase (Opcional)
# ====================
VITE_FIREBASE_API_KEY=sua_chave_firebase_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
VITE_FIREBASE_APP_ID=seu-app-id

# ====================
# Analytics (Opcional)
# ====================
VITE_GOOGLE_ANALYTICS_ID=UA-00000000-0
VITE_SENTRY_DSN=https://seu-sentry-dsn@sentry.io/seu-id

# ====================
# Environment
# ====================
VITE_NODE_ENV=development
VITE_DEBUG_MODE=false

# ====================
# IMPORTANTE
# ====================
# 1. Nunca compartilhe este arquivo (.env) com valores preenchidos
# 2. Sempre use .env.local para desenvolvimento local
# 3. Configure as variáveis no painel de administração do seu provedor
# 4. Em produção, configure via variáveis de ambiente do servidor