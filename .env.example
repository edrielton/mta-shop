# ============================================================
#  MTA STORE — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA suba o arquivo .env para o Git!
# ============================================================

# ----- BANCO DE DADOS (PostgreSQL) -------------------------
# Formato: postgresql://usuario:senha@host:5432/nome_banco
DATABASE_URL=postgresql://usuario:senha@host:5432/mta_store

# ----- SESSÃO (gere uma string aleatória longa) -------------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=coloque_aqui_uma_string_longa_e_aleatoria

# ----- JWT (gere uma string aleatória longa) ----------------
JWT_SECRET=coloque_aqui_outra_string_longa_e_aleatoria

# ----- MERCADO PAGO (pagamentos) ---------------------------
# Encontre em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# Para receber confirmações de pagamento via webhook (opcional mas recomendado):
# Docs: https://www.mercadopago.com.br/developers/pt/docs/notifications/webhooks
MP_WEBHOOK_SECRET=coloque_aqui_o_secret_do_webhook

# ----- MTA STORE -------------------------------------------
# Token de autenticação entre o site e o servidor MTA
# IMPORTANTE: Use o MESMO token em mta_store/config.lua
MTA_STORE_TOKEN=coloque_um_token_de_32_caracteres

# ----- AMBIENTE ---------------------------------------------
NODE_ENV=production
PORT=5000
APP_URL=https://seudominio.com

# ----- PAINEL ADMIN ----------------------------------------
ADMIN_ALLOWED_IPS=177.37.234.78
