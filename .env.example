# ============================================================
#  MTA STORE — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA suba o arquivo .env para o Git!
# ============================================================

# ----- BANCO DE DADOS (PostgreSQL) -------------------------
# Formato: postgresql://usuario:senha@host:5432/nome_banco
# Neon (gratuito): https://neon.tech
# Railway: gerado automaticamente ao adicionar PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/mta_store

# ----- SESSÃO (gere uma string aleatória longa) -------------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=coloque_aqui_uma_string_longa_e_aleatoria

# ----- STRIPE (pagamentos) ----------------------------------
# Encontre em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Para receber confirmações de pagamento via webhook:
# Crie em: https://dashboard.stripe.com/webhooks
# URL do webhook: https://seudominio.com/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- AMBIENTE ---------------------------------------------
NODE_ENV=production
PORT=5000
