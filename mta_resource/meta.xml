<?xml version="1.0" encoding="UTF-8"?>
<meta>
    <info
        author="MTA Store"
        version="1.3.0"
        description="MTA Store - Loja online integrada com sync de dados RP"
        type="misc"
    />

    <!-- 1. Configuração (carregada primeiro) -->
    <script src="config.lua"     type="server" cache="false"/>

    <!-- 2. Lógica principal (ativações, fila offline, retry) -->
    <script src="server.lua"     type="server" cache="false"/>

    <!-- 3. Sync de dados dos jogadores com o site -->
    <script src="sync.lua"       type="server" cache="false"/>

    <!-- Endpoints HTTP -->
    <!-- POST /mta_store/activate  → ativar item comprado       -->
    <!-- GET  /mta_store/health    → health check               -->
    <html src="activate.lua"  default="false" raw="false"/>

    <!-- GET  /mta_store/scan      → listar resources           -->
    <html src="scanner.lua"   default="false" raw="false"/>

    <!-- GET  /mta_store/autotoken → validar token auto-login   -->
    <html src="autotoken.lua" default="false" raw="false"/>

    <!-- Fila de ativações offline -->
    <file src="queue.json"/>
</meta>
