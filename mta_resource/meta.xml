<?xml version="1.0" encoding="UTF-8"?>
<meta>
    <info
        author="MTA Store"
        version="1.2.0"
        description="MTA Store - Ativação automática de itens comprados no site"
        type="misc"
    />

    <!-- Configuração (carregada primeiro) -->
    <script src="config.lua"   type="server" cache="false"/>

    <!-- Lógica principal -->
    <script src="server.lua"   type="server" cache="false"/>

    <!-- Endpoint: POST /mta_store/activate  (ativar item comprado) -->
    <!-- Endpoint: GET  /mta_store/health    (health check)         -->
    <html src="activate.lua" default="false" raw="false"/>

    <!-- Endpoint: GET  /mta_store/scan      (escanear resources)   -->
    <html src="scanner.lua"  default="false" raw="false"/>

    <!-- Fila offline -->
    <file src="queue.json"/>
</meta>
